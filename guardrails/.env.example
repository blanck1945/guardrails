# Copy to .env.local for local runs (git-ignored). On Vercel, add each variable with `vercel env add`
# (mark secrets as sensitive). NEVER commit real values.

# ---------------------------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------------------------
# Model spec: `zai:<id>`, `deepseek:<id>` or any AI Gateway id (e.g. anthropic/claude-sonnet-5).
# Default when unset: anthropic/claude-sonnet-5 (needs AI_GATEWAY_API_KEY).
GUARDRAILS_MODEL=zai:glm-5.3

# Provider credential: set the one that matches GUARDRAILS_MODEL.
ZAI_API_KEY=
DEEPSEEK_API_KEY=
AI_GATEWAY_API_KEY=

# Dev/eval only, never in production: replay identical model calls from eval/.cache/llm.
# GUARDRAILS_LLM_CACHE=1

# ---------------------------------------------------------------------------------------------
# GitHub App (webhook only; the local CLI does not need these). See docs/github-app-setup.md
# ---------------------------------------------------------------------------------------------
# Numeric App ID, shown on the App's settings page ("About" section).
GITHUB_APP_ID=
# The .pem private key on ONE line, newlines written as \n:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=
# Random string; must be identical to the "Webhook secret" configured in the App.
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------------
# Local hook / CLI (optional)
# ---------------------------------------------------------------------------------------------
# Per-review budget in USD used by the pre-push hook (default 0.50).
# GUARDRAILS_BUDGET_USD=0.50
