{
  "name": "guardrails",
  "version": "0.7.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx eval/cli.ts",
    "guardrails": "tsx src/cli/guardrails.ts",
    "smoke:cloud": "node -e \"process.env.GUARDRAILS_SMOKE=1;require('child_process').spawnSync('pnpm',['vitest','run','src/cloud/smoke.integration.test.ts','--disable-console-intercept'],{stdio:'inherit',shell:true,env:process.env})\"",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.55",
    "ai": "^7.0.112",
    "next": "^16.3.6",
    "octokit": "^5.0.5",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "safe-regex2": "^5.1.1",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
